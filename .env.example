# Optional MongoDB connection used by the metadata integration.
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# Optional AWS model artifact storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REGION_NAME=
MODEL_BUCKET_NAME=
CORS_ALLOW_ORIGINS=http://127.0.0.1:5000
